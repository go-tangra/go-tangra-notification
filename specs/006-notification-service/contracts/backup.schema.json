{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freya.example.org/schemas/notification-backup-v1.json",
  "title": "Notification tenant backup",
  "description": "Document produced by POST /api/notification/v1/backup/export and accepted by /backup/import. Credentials are present only when the export asked for them; import treats missing credential fields as 'not set'. Messages, inbox entries and the notification log are never included. Limits: 16 MiB, 10,000 items in total.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "exported_at", "channels", "templates", "categories"],
  "properties": {
    "version": { "const": 1 },
    "exported_at": { "type": "string", "format": "date-time" },
    "tenant": { "type": "string", "description": "informational; the import target is the caller's tenant" },
    "includes_credentials": { "type": "boolean", "default": false },
    "channels": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "settings"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "type": { "type": "string", "enum": ["email", "sms", "slack", "sse"] },
          "settings": { "type": "object", "description": "provider settings; credential fields omitted unless includes_credentials" },
          "enabled": { "type": "boolean", "default": false },
          "is_default": { "type": "boolean", "default": false }
        }
      }
    },
    "templates": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "subject", "body"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "channel": { "type": "string", "maxLength": 100, "description": "channel name in this document or in the target tenant; unknown → imported without a channel and reported" },
          "channel_type": { "type": "string", "enum": ["email", "sms", "slack", "sse"] },
          "subject": { "type": "string", "maxLength": 998 },
          "body": { "type": "string", "maxLength": 262144 },
          "variables": { "type": "array", "maxItems": 50, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" } },
          "is_default": { "type": "boolean", "default": false }
        }
      }
    },
    "categories": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "type": "string", "maxLength": 500 },
          "sort": { "type": "integer", "minimum": 0, "maximum": 100000 }
        }
      }
    }
  }
}
